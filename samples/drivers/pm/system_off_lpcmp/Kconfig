mainmenu "Alif PM LPCMP Wakeup Demo"

config APP_LPCMP_WAKEUP_ROUNDS
	int "Number of sleep/wake rounds to run"
	default 0
	help
	  Number of STANDBY + STOP sleep rounds to run before parking in an
	  idle loop. 0 means run forever, which is what you usually want on the
	  bench so the comparator input can be poked repeatedly.

source "Kconfig.zephyr"
