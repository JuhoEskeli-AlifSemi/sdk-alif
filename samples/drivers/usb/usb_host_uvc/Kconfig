mainmenu "USB Host UVC Capture Sample"

config SAMPLE_UVC_FORMAT_INDEX
	int "Format to stream (bFormatIndex)"
	range 0 255
	default 0
	help
	  bFormatIndex of the video format to request from the device. 0
	  selects the first format the device lists or, with the display, any
	  format the display can show.

config SAMPLE_UVC_FRAME_INDEX
	int "Frame size to stream (bFrameIndex)"
	range 0 255
	default 0
	help
	  bFrameIndex of the frame size to request within the selected format.
	  0 selects the format's default frame (bDefaultFrameIndex) or, with
	  the display, the largest frame the display shows without shrinking
	  it, turned by 90 degrees if need be.

config SAMPLE_UVC_DISPLAY_ROTATE_CCW
	bool "Turn frames counter-clockwise on the display"
	depends on DISPLAY
	help
	  Frames that fill more of the display turned by 90 degrees, such as
	  landscape frames on the DK's portrait panel, are turned clockwise,
	  which puts the top of the picture on the right of the panel. Select
	  this to turn them counter-clockwise instead.

config SAMPLE_UVC_FRAME_BUFFER_SIZE
	int "Frame reassembly buffer size in bytes"
	default 614400
	help
	  Size of the buffer each frame is reassembled into, in SRAM0. The
	  device's dwMaxVideoFrameSize for the negotiated format must fit. The
	  default holds a 640x480 frame at 16 bits per pixel.

config SAMPLE_UVC_TRACE_XFERS
	int "Log the first N transfers"
	range 0 64
	default 0
	help
	  Record the length and first bytes of the first N bulk or isochronous
	  IN transfers after the first stream starts and log them once N have
	  arrived, to debug payload framing. 0 disables the trace.

source "Kconfig.zephyr"
