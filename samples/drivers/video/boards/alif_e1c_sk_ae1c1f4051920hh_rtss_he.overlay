#include <dt-bindings/pinctrl/ensemble-e1c-pinctrl.h>
#include <dt-bindings/i2c/i2c.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/video/video-interfaces.h>

/*
 * Latency probe: P0_3 driven high at boot, low when capture starts,
 * high again when a frame has been dequeued.  Used for oscilloscope
 * measurements of camera acquisition latency.
 */
/ {
	zephyr,user {
		latency-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl {
	pinctrl_gpio0_latency: pinctrl_gpio0_latency {
		group0 {
			pinmux = <PIN_P0_3__GPIO>;
			read-enable = <0x1>;
		};
	};
};

&pinctrl_uart2 {
	group0 {
		driver-state-control = <1>; /* pull-up: initialize RX active-high */
	};
};

&gpio0 {
	pinctrl-0 = <&pinctrl_gpio0_latency>;
	status = "okay";
};

&ns {
	status = "okay";
};

/*
 * Override gpio1 pinctrl to exclude P1_0 (JTAG_TMS), P1_1 (JTAG_TDI) and
 * P1_2 (JTAG_TDO) which are connected to the JTAG debug connector on the
 * E1C SK board. The default pinctrl_gpio1 covers the full port and would
 * remux those pads to GPIO, breaking the debug interface.
 */
&pinctrl {
	pinctrl_gpio1_video: pinctrl_gpio1_video {
		group0 {
			pinmux = <PIN_P1_3__GPIO>,
				 <PIN_P1_4__GPIO>,
				 <PIN_P1_5__GPIO>,
				 <PIN_P1_6__GPIO>,
				 <PIN_P1_7__GPIO>;
			read-enable = <0x1>;
		};
	};
};

&gpio1 {
	pinctrl-0 = <&pinctrl_gpio1_video>;
	status = "okay";
};

&pinctrl_lpgpio {
	group0 {
		pinmux = <PIN_P15_0__LPGPIO>,
			 <PIN_P15_1__LPGPIO>;
		read-enable = <1>;
		driver-state-control = <1>;
		drive-strength = <8>;
	};
};

&lpgpio {
	pinctrl-0 = <&pinctrl_lpgpio>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * Capture trigger button on LPGPIO 0 (P15_0). Reuses the simple_pm
 * "wakeup_pins" / "lpgpio-wakeup-pin" pattern so the same node also drives
 * the PM wakeup path.
 */
/ {
	wakeup_pins: wakeup_pins {
		compatible = "lpgpio-wakeup-pin";
		lpgpios = <&lpgpio 0 GPIO_ACTIVE_LOW>;
	};
};

/*
 * PM bits: RTC as Cortex-M idle timer, S2RAM as the chosen low-power state.
 * The video sample does not arm the RTC for timed wakeups — it serves only
 * as the idle-time reference for the LPM systick hooks.
 */
&rtc0 {
	prescaler = <1>;
	status = "okay";
};

&stop_s2ram {
	min-residency-us = <4000>;
	exit-latency-us = <3000>;
	status = "okay";
};

/ {
	chosen {
		zephyr,cortex-m-idle-timer = &rtc0;
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	hcnt-offset = <10>;
	lcnt-offset = <10>;

	ov5640: ov5640@3c{
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		status = "okay";
		reset-gpios = <&lpgpio 1 GPIO_ACTIVE_LOW>;
		powerdown-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;

		port {
			ov5640_ep_out: endpoint {
				bus-type = <VIDEO_BUS_TYPE_PARALLEL>;
				remote-endpoint-label = "lpcam_ep_in";
			};
		};
	};
};

&lpcam {
	status = "okay";
	cpi-interface = "parallel";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		/* Camera Input Endpoint. For LP-CAM it is only camera */
		port@0 {
			reg = <0>;
			lpcam_ep_in: endpoint {
				remote-endpoint-label = "ov5640_ep_out";
			};
		};

		/* Video buffer output endpoint. */
		port@1 {
			reg = <1>;
			cam_mem_ep_out: endpoint {
				remote-endpoint-label = "application";
			};
		};


	};
};
