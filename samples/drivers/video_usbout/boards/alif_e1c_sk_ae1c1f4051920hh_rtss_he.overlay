#include <dt-bindings/pinctrl/balletto-pinctrl.h>
#include <dt-bindings/i2c/i2c.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/video/video-interfaces.h>

ns: &ns {  
	status = "okay";  
	reg = < 0x200A0000 DT_SIZE_K(512)>;  
};

/* USB */
zephyr_udc0: &usb {
	status = "okay";
};

/* RAM Disk for USB MSC - sized for captured image + FAT overhead */
/ {
	ramdisk0 {
		compatible = "zephyr,ram-disk";
		disk-name = "RAM";
		sector-size = <512>;
		sector-count = <1024>;
	};
};

/* Camera */
&gpio1 {
	status = "okay";
};

&lpgpio {
	status = "okay";
};

&i2c1 {
	status = "okay";

	ov5640: ov5640@3c{
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		status = "okay";
		reset-gpios = <&lpgpio 1 GPIO_ACTIVE_LOW>;
		powerdown-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;

		port {
			ov5640_ep_out: endpoint {
				bus-type = <VIDEO_BUS_TYPE_PARALLEL>;
				remote-endpoint-label = "lpcam_ep_in";
			};
		};
	};
};

&lpcam {
	status = "okay";
	pinctrl-0 = <&pinctrl_lpcam>;
	pinctrl-names = "default";
	cpi-interface = "parallel";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			lpcam_ep_in: endpoint {
				remote-endpoint-label = "ov5640_ep_out";
			};
		};

		port@1 {
			reg = <1>;
			cam_mem_ep_out: endpoint {
				remote-endpoint-label = "application";
			};
		};
	};
};
