#include <dt-bindings/pinctrl/balletto-pinctrl.h>
#include <dt-bindings/i2c/i2c.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/video/video-interfaces.h>

/*
 * DTCM is 1536K (0x20000000..0x20180000). B1 layout for this sample:
 *
 *   [0x20000000 .. 0x2000A000)   40K  reserved_dtcm
 *   [0x2000A000 .. 0x20020000)        Zephyr core (.data/.bss/heap/stacks;
 *                                     only ~18K used)
 *   [0x20020000 .. 0x200A0000)  512K  RAMDISK: USB MSC RAM disk (ram-region)
 *   [0x200A0000 .. 0x200C0000)  128K  UNUSABLE on B1: this DTCM bank is not
 *                                     backed - writes fault (see RAM disk note)
 *   [0x200C0000 .. 0x20180000)  768K  NON_SECURE0 (this node): USB DMA
 *                                     buffers + video capture pool
 *                                     (.alif_ns section, soc/.../alif_ns.ld)
 *
 * Do NOT shrink the &dtcm node reg to carve these out: local_to_global()
 * (modules/hal/alif) maps DTCM local addresses to the global bus address every
 * DMA master (CPI, USB, ...) uses, via DT_REG_SIZE(dtcm). A short reg puts
 * NON_SECURE0 (0x200C0000) outside that range, so the CPI/USB DMA writes to an
 * untranslated address and the bus returns DECERR (AXI BRESP=3). RAMDISK and
 * NON_SECURE0 therefore overlap the full DTCM/zephyr,sram space but sit at fixed
 * addresses the kernel leaves unused - as .alif_ns already does.
 *
 * The video pool (camera DMA target) and the USB buffers must live in
 * NON_SECURE0, so growing the capture buffer means growing this region.
 *
 * CRITICAL: the base AND size must be aligned to the DTCM TGU block size.
 * At boot sau_tcm_ns_setup() (modules/hal/alif) marks this region non-secure
 * in BOTH the SAU (exact, 32-byte granular) and the TGU (whole DTCM blocks,
 * via integer division - see tgu.c). If the base is not block-aligned the
 * TGU marks the partial block below it non-secure while the SAU keeps it
 * secure; any secure access into that window then faults (BusFault/MemManage).
 * The DTCM TGU block on B1 is 128K; 0x200C0000 is 768K (6*128K) from the DTCM
 * base, which is block-aligned. Do not give this an unaligned base.
 *
 * Keep in sync with CONFIG_VIDEO_BUFFER_POOL_SZ_MAX (.conf),
 * JPEG_CAPTURE_MAX_BYTES (main.c) and the RAM disk size below.
 */
ns: &ns {
	status = "okay";
	reg = < 0x200C0000 DT_SIZE_K(768)>;
};

/* USB */
zephyr_udc0: &usb {
	status = "okay";
};

/*
 * RAM Disk for USB MSC. The balletto SoC linker force-routes .bss.disk_buf_0
 * into NON_SECURE0 (soc/.../alif_ns.ld), where it would collide with the 673K
 * video pool. Give the disk its own DTCM region via ram-region instead: with a
 * ram-region phandle the driver emits no disk_buf_0 symbol (ramdisk.c), so that
 * KEEP line matches nothing and the shared SoC linker needs no edit.
 *
 * The region is 512K and ends at 0x200A0000: although &dtcm claims 1496K, the
 * 128K DTCM bank at 0x200A0000..0x200C0000 is not backed on B1 (a write there
 * faults with a precise bus error - confirmed by memset), so the disk must stop
 * below it. 512K holds a ~470K JPEG + FAT; a larger frame (up to the 672K
 * JPEG_CAPTURE_MAX_BYTES worst case) is dropped by the sample's short-write
 * check rather than corrupting memory. The region overlaps zephyr,sram but the
 * kernel (only ~18K of core .bss, no large heap) never reaches it - see the
 * DECERR note above for why &dtcm stays full.
 */
/ {
	ramdisk_mem: memory@20020000 {
		compatible = "zephyr,memory-region";
		reg = <0x20020000 DT_SIZE_K(512)>;
		zephyr,memory-region = "RAMDISK";
	};

	ramdisk0 {
		compatible = "zephyr,ram-disk";
		ram-region = <&ramdisk_mem>;
		disk-name = "RAM";
		sector-size = <512>;
		sector-count = <1024>;
	};
};

/*
 * Override gpio1 pinctrl to exclude P1_0 (JTAG_TMS), P1_1 (JTAG_TDI) and
 * P1_2 (JTAG_TDO) which are connected to the JTAG debug connector on the
 * B1 SK board. The default pinctrl_gpio1 covers the full port and would
 * remux those pads to GPIO, breaking the debug interface.
 */
&pinctrl {
	pinctrl_gpio1_video: pinctrl_gpio1_video {
		group0 {
			pinmux = <PIN_P1_3__GPIO>,
				 <PIN_P1_4__GPIO>,
				 <PIN_P1_5__GPIO>,
				 <PIN_P1_6__GPIO>,
				 <PIN_P1_7__GPIO>;
			read-enable = <0x1>;
		};
	};
};

&gpio1 {
	pinctrl-0 = <&pinctrl_gpio1_video>;
	status = "okay";
};

&lpgpio {
	status = "okay";
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	hcnt-offset = <10>;
	lcnt-offset = <10>;

	ov5640: ov5640@3c{
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		status = "okay";
		reset-gpios = <&lpgpio 1 GPIO_ACTIVE_LOW>;
		powerdown-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;

		port {
			ov5640_ep_out: endpoint {
				bus-type = <VIDEO_BUS_TYPE_PARALLEL>;
				remote-endpoint-label = "lpcam_ep_in";
			};
		};
	};
};

&lpcam {
	status = "okay";
	cpi-interface = "parallel";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		/* Camera Input Endpoint. For LP-CAM it is only camera */
		port@0 {
			reg = <0>;
			lpcam_ep_in: endpoint {
				remote-endpoint-label = "ov5640_ep_out";
			};
		};

		/* Video buffer output endpoint. */
		port@1 {
			reg = <1>;
			cam_mem_ep_out: endpoint {
				remote-endpoint-label = "application";
			};
		};
	};
};
